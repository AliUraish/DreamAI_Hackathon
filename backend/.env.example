# --- required for the full product ---------------------------------------------------
# Neon (Postgres) connection string. Without it Chowkidaar falls back to a local SQLite file.
NEON_DB=
# OpenAI key: writes migrations, addresses PR reviews, words the graph explanations.
OPENAI_KEY=

# --- optional ---------------------------------------------------------------------------
# CHOWKIDAAR_OPENAI_MODEL=gpt-5
# CHOWKIDAAR_GITHUB_TOKEN=                 # falls back to `gh auth token`
# CHOWKIDAAR_OPEN_PRS=true                 # false = prepare the branch locally, never push
# CHOWKIDAAR_PUBLIC_URL=http://localhost:8000   # where a connected project reaches this backend
# CHOWKIDAAR_APP_URL=http://localhost:5173      # where the UI is served
# CHOWKIDAAR_POLL_INTERVAL_SECONDS=21600   # contract polling (6h); 0 = only on demand
# CHOWKIDAAR_ENV_WATCH_SECONDS=5           # env files of path-connected repos; connector repos push instead
# CHOWKIDAAR_PREFETCH_EXPLANATIONS=true     # the model explains every connection ahead of the click (about 100 short calls per project)
# CHOWKIDAAR_PR_WATCH_SECONDS=20           # review comments and merges on open pull requests
# CHOWKIDAAR_ACME_ORDERS_URL=http://localhost:4010   # the demo API provider
# ELEVENLABS_API_KEY=                      # live drift monitoring of sponsor APIs
# NEBIUS_API_KEY=
# ANTHROPIC_API_KEY=                       # used only when OPENAI_KEY is not set
